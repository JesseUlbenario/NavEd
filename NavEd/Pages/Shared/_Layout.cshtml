<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NavEd</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/NavEd.styles.css" asp-append-version="true" />
</head>
<body>
    <!-- HEADER -->
    <header>
        <!-- PROFILE HEADER -->
        <div id="custom-profile-header">
            <!-- AVATAR -->
            <div class="profile-avatar">
                <img src="~/images/user.jpg" class="profile-icon-large" alt="Profile"/>
            </div>

            <!-- PROFILE DETAILS -->
            <div class="profile-details">
                <h1 class="profile-name">JANE QUIROS BANSALAN</h1>
                <p class="profile-info-item">A222</p>
                <p class="profile-info-item">2024123456</p>
            </div>

            <!-- BURGER MENU -->
            <button class="menu-toggle-button">
                <span class="burger-icon"></span>
                <span class="burger-icon"></span>
                <span class="burger-icon"></span>
            </button>
        </div>

        <!-- CALENDAR BUTTON (fixed, above header) -->
        <button id="calendar-button" class="calendar-button">
            <i class="bi bi-calendar-event"></i>
        </button>

        <!-- EVENTS PANEL -->
        <div id="events-panel">
            <div class="events-header">
                <h3>Upcoming Events</h3>
                <button id="close-events">&times;</button>
            </div>
            <div id="events-list">
                <!-- Populated in Index.cshtml -->
            </div>
        </div>

        <!-- SIDE MENU -->
        <div id="menu-overlay"></div>
        <div id="side-menu">
            <div class="side-menu-header">
                <h3>Menu</h3>
                <button id="close-menu">&times;</button>
            </div>
            <ul>
                <li><a href="#"><span class="menu-icon">&#9881;</span> Settings</a></li>
                <li><a href="#"><span class="menu-icon">&#128100;</span> Profile</a></li>
                <li><a href="#"><span class="menu-icon">&#128340;</span> History</a></li>
                <li><a href="#"><span class="menu-icon">&#128274;</span> Logout</a></li>
            </ul>
        </div>
    </header>

    <!-- MAIN CONTENT -->
    <main role="main" class="pb-3">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="border-top footer text-muted">
        &copy; 2025 - NavEd - <a href="#">Home</a>
    </footer>

   @RenderSection("Scripts", required: false)
</body>
</html>
