<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NavEd</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/NavEd.styles.css" asp-append-version="true" />
</head>
<body>
<header>
    <div id="custom-profile-header">

        <!-- AVATAR -->
        <div class="profile-avatar">
            <img src="~/images/user.jpg" class="profile-icon-large" alt="Profile"/>
        </div>

        <!-- TEXT -->
        <div class="profile-details">
            <h1 class="profile-name">JANE QUIROS BANSALAN</h1>
            <p class="profile-info-item">A222</p>
            <p class="profile-info-item">2024123456</p>
        </div>

        <!-- BURGER MENU -->
        <button class="menu-toggle-button">
            <span class="burger-icon"></span>
            <span class="burger-icon"></span>
            <span class="burger-icon"></span>
        </button>
    </div>
</header>

        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    <footer class="border-top footer text-muted">
      
            &copy; 2025 - NavEd - <a asp-area="" asp-page="/Privacy">Privacy</a>
     
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

