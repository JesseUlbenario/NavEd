@page
@model IndexModel
@{
    ViewData["Title"] = "Movement Tracker with Profile";
}

@* APP CONTAINER *@
<div id="app-container">
    <div id="search-bar">
        <input type="text" placeholder="Search for locations or people..." />
    </div>

    <div id="map-container">
        <div id="tracker-dot"></div>
    </div>
</div>

@section Scripts {
    <script src="~/js/tracker.js"></script>
}
